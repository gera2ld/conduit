{
  "name": "@gera2ld/conduit",
  "version": "0.1.3",
  "license": "MIT",
  "bin": {
    "conduit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build && chmod +x dist/cli.js",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "check": "tsc --noEmit && oxlint --fix && oxfmt",
    "conduit": "bun src/cli.ts",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {
    "@gera2ld/common": "^0.1.3",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.1",
    "jsonata": "^2.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "del-cli": "^7.0.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
