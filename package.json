{
  "name": "conduit-monorepo",
  "private": true,
  "description": "Workspace root. The published package lives under packages/; spec/ holds the language-neutral definition of the format.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gera2ld/conduit.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && bun run --filter '*' check && oxlint --fix && oxfmt",
    "spec": "bun test ./spec/conformance.test.ts",
    "test": "bun --filter '*' test && bun test ./spec"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "ajv": "^8.20.0",
    "js-yaml": "^5.4.1",
    "jsonata": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  }
}
