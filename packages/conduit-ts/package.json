{
  "name": "@gera2ld/conduit",
  "version": "0.1.3",
  "description": "Turn any composition of external HTTP APIs into a single async function — declaratively.",
  "homepage": "https://github.com/gera2ld/conduit",
  "bugs": {
    "url": "https://github.com/gera2ld/conduit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gera2ld/conduit.git"
  },
  "bin": {
    "conduit": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "del-cli dist tsconfig.tsbuildinfo",
    "check": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build && chmod +x dist/cli.js",
    "build:schema": "cp ../../spec/schema/conduit.schema.json dist/conduit.schema.json",
    "build": "bun run clean && bun run build:js && bun run build:types && bun run build:schema",
    "conduit": "bun src/cli.ts",
    "test": "bun test src",
    "prepublishOnly": "bun run build && bun run test"
  },
  "dependencies": {
    "@gera2ld/common": "^0.1.3",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "js-yaml": "^5.4.1",
    "jsonata": "^2.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "del-cli": "^7.0.0",
    "vite": "^8.2.2"
  },
  "schema": "./dist/conduit.schema.json"
}
